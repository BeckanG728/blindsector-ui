<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">

    <!-- ========================= -->
    <!-- STRING REQUERIDO -->
    <!-- Shortcut: mstr -->
    <!-- ========================= -->

    <CodeSnippet Format="1.0.0">
        <Header>
        <Title>Modelo String</Title>
        <Shortcut>mstr</Shortcut>
        <Description>Propiedad string con validaciones</Description>
        <Author>Beckan</Author>
        </Header>

        <Snippet>

        <Declarations>

            <Literal>
            <ID>Campo</ID>
            <Default>Nombres</Default>
            </Literal>

            <Literal>
            <ID>Max</ID>
            <Default>50</Default>
            </Literal>

            <Literal>
            <ID>Mensaje</ID>
            <Default>Debe ingresar el valor</Default>
            </Literal>

        </Declarations>

        <Code Language="csharp"><![CDATA[
            [Display(Name = "$Campo$")]
            [Required(ErrorMessage = "$Mensaje$")]
            [MaxLength($Max$, ErrorMessage = "El campo no debe tener mas de $Max$ caracteres")]
            public string $Campo$ { get; set; }

            ]]>
        </Code>

        </Snippet>
    </CodeSnippet>





  <!-- ========================= -->
  <!-- ID -->
  <!-- Shortcut: mid -->
  <!-- ========================= -->

    <CodeSnippet Format="1.0.0">
        <Header>
        <Title>Modelo ID</Title>
        <Shortcut>mid</Shortcut>
        <Description>Propiedad ID</Description>
        <Author>Beckan</Author>
        </Header>

        <Snippet>

        <Declarations>

            <Literal>
            <ID>Campo</ID>
            <Default>IdColaborador</Default>
            </Literal>

        </Declarations>

        <Code Language="csharp"><![CDATA[
            [Key]
            [Display(Name = "Id")]
            [Required]
            public int $Campo$ { get; set; }
            ]]>
        </Code>

        </Snippet>
    </CodeSnippet>






    <!-- ========================= -->
    <!-- FOREIGN KEY -->
    <!-- Shortcut: mfk -->
    <!-- ========================= -->

    <CodeSnippet Format="1.0.0">
        <Header>
        <Title>Foreign Key</Title>
        <Shortcut>mfk</Shortcut>
        <Description>Relación FK</Description>
        <Author>Beckan</Author>
        </Header>

        <Snippet>

        <Declarations>

            <Literal>
            <ID>Entidad</ID>
            <Default>Empresa</Default>
            </Literal>

        </Declarations>

        <Code Language="csharp"><![CDATA[
            public int Id$Entidad$ { get; set; }

            [ForeignKey("Id$Entidad$")]
            public virtual $Entidad$ $Entidad$ { get; set; }

            ]]>
        </Code>

        </Snippet>
    </CodeSnippet>







